'emotional_links': [{'type': 'non-romantic', 'magnitude': 3, 'from': 'a', 'to': 'b'}], 'tensions': []}}, {'action': 'huff_and_puff', 'n_characters': 2, 'subject': 'wolf', 'object': 'second little pig, third little pig', 'preconditions': {'emotional_links': [{'type': 'non-romantic', 'magnitude': -3, 'from': 'a', 'to': 'b'}], 'tensions': [{'type': 'life_at_risk', 'from': 'a', 'to': 'b'}]}, 'postconditions': {'emotional_links': [], 'tensions': []}}, {'action': 'escape', 'n_characters': 3, 'subject': 'first little pig, second little pig', 'object': 'third little pig', 'preconditions': {'emotional_links': [{'type': 'non-romantic', 'magnitude': 2, 'from': 'a', 'to': 'b'}, {'type': 'non-romantic', 'magnitude': 2, 'from': 'b', 'to': 'c'}], 'tensions': [{'type': 'life_at_risk', 'from': '-', 'to': 'c'}]}, 'postconditions': {'emotional_links': [{'type': 'non-romantic', 'magnitude': 3, 'from': 'a', 'to': 'b'}, {'type': 'non-romantic', 'magnitude': 3, 'from': 'b', 'to': 'c'}], 'tensions': []}}, {'action': 'huff_and_puff', 'n_characters': 2, 'subject': 'wolf', 'object': 'three little pigs', 'preconditions': {'emotional_links': [{'type': 'non-romantic', 'magnitude': -3, 'from': 'a', 'to': 'b'}], 'tensions': [{'type': 'life_at_risk', 'from': 'a', 'to': 'b'}]}, 'postconditions': {'emotional_links': [], 'tensions': []}}, {'action': 'climb_down_chimney', 'n_characters': 2, 'subject': 'wolf', 'object': 'third little pig', 'preconditions': {'emotional_links': [{'type': 'non-romantic', 'magnitude': -3, 'from': 'a', 'to': 'b'}], 'tensions': [{'type': 'life_at_risk', 'from': 'a', 'to': 'b'}]}, 'postconditions': {'emotional_links': [], 'tensions': []}}, {'action': 'boil', 'n_characters': 4, 'subject': 'three little pigs', 'object': 'wolf', 'preconditions': {'emotional_links': [{'type': 'non-romantic', 'magnitude': -2, 'from': 'a', 'to': 'b'}], 'tensions': []}, 'postconditions': {'emotional_links': [{'type': 'non-romantic', 'magnitude': 1, 'from': 'a', 'to': 'b'}], 'tensions': []}}]
